['STATIONCODE']=df.STATIONCODE.astype(object)\n","  df ['YEAR']=df.YEAR.astype(object)\n","\n","  df_num = df.select_dtypes(exclude=\"object\")\n","\n","  df_num_col = df_num.columns\n","  imputer = SimpleImputer(strategy=\"mean\")\n","  df_num = imputer.fit_transform(df_num)\n","  df_num = pd.DataFrame(df_num, columns=df_num_col)\n","\n","  df_cat = df.select_dtypes(include=\"object\")\n","\n","  df_final = pd.concat([df_cat, df_num], axis=1)\n","\n","  df_num_final = df_final.select_dtypes(exclude=\"object\")\n","  df_num_final_norm = zscore(df_num_final, axis=0)\n","  def indices_of_greater_than_4(df_norm):\n","    indices_arr = []\n","    n_col = df_norm.shape[1]\n","    for index in range(n_col):\n","        col_index = df_norm.iloc[: ,index]\n","        greater_than_4 = df_norm[col_index > 4]\n","        greater_than_4_index = greater_than_4.index\n","        indices_arr.extend(greater_than_4_index)\n","    return indices_arr\n","  indices_arr = indices_of_greater_than_4(df_num_final_norm)\n","\n","  # Calculating Water Quality Index of each sample\n","  df_num_final = df_final.select_dtypes(exclude=\"object\")\n","  # Weight Vector(wi)\n","  wi = np.array([0.2213, 0.2604, 0.4426, 0.0221,  0.0022,0.0022, 0.0492])\n","  # Standard values of parameters(si)\n","  si = np.array([10, 8.5,  5, 100, 1000,1000, 45])\n","  # Ideal values of paramters(vIdeal)\n","  vIdeal = np.array([14.6, 7, 0, 0, 0, 0, 0])\n","\n","  def calc_wqi(sample):\n","      wqi_sample = 0\n","      num_col = 7\n","      for index in range(num_col):\n","          v_index = sample[index] # Obeserved value of sample at index\n","          v_index_ideal = vIdeal[index] # Ideal value of obeserved value\n","          w_index = wi[index] # weight of corresponding parameter of obeserved value\n","          std_index = si[index] # Standard value recommended for obeserved value\n","          q_index = (v_index - v_index_ideal) / (std_index - v_index_ideal)\n","          q_index = q_index * 100 # Final qi value of obeserved value\n","          wqi_sample += q_index*w_index\n","      return wqi_sample\n","\n","  # Computing WQI for the whole dataset\n","  def calc_wqi_for_df(df):\n","      wqi_arr = []\n","      for index in range(df.shape[0]):\n","          index_row = df.iloc[index, :]\n","          wqi_row = calc_wqi(index_row)\n","          wqi_arr.append(wqi_row)\n","      return wqi_arr\n","\n","  wqi_arr = calc_wqi_for_df(df_num_final)\n","  # Converting oridnary array to numpy array\n","  wqi_arr = np.array(wqi_arr)\n","  wqi_arr = np.reshape(wqi_arr, (-1, 1))\n","\n","  # Resetting index values of the dataframes\n","  wqi_arr_df = pd.DataFrame(wqi_arr, columns=[\"WQI\"]).reset_index()\n","  df_final = df_final.reset_index()\n","\n","  # Combining dataframe of WQI and dataframe of attributes\n","  df_wqi = pd.concat([df_final, pd.DataFrame(wqi_arr, columns=[\"WQI\"])], axis=1)\n","  df_wqi.drop(\"index\", axis=1, inplace=True)\n","  df = df_wqi\n","\n","  timeseries_data = df['WQI']\n","  def create_sequences(timeseries_data, window_size):\n","    X = []\n","    y = []\n","    for i in range(len(timeseries_data) - window_size):\n","        X.append(timeseries_data[i:i+window_size])\n","        y.append(timeseries_data[i+window_size])\n","    return np.array(X), np.array(y)\n","\n","  window_size = 5\n","  X, y = create_sequences(timeseries_data, window_size)\n","\n","  # reshape from [samples, timesteps] into [samples, timesteps, features]\n","  n_features = 1\n","  n_steps= 5\n","  X = X.reshape((X.shape[0], X.shape[1], n_features))\n","\n","\n","  # CNN-BiLSTM model\n","  model = Sequential()\n","  model.add(Conv1D(filters=64, kernel_size=3, activation='relu', input_shape=(n_steps, n_features)))\n","  model.add(Bidirectional(LSTM(50, activation='relu', input_shape=(n_steps, n_features))))\n","  model.add(Dense(1))\n","  model.compile(loss='mean_squared_error', optimizer='adam')\n","\n","  model.fit(X, y, epochs=400, verbose=1)\n","\n","  d= timeseries_data[(len(timeseries_data)-n_steps):]\n","  dx = np.array(d)\n","  temp_input=list(dx)\n","  dx = dx.reshape((1, n_steps, n_features))\n","  yhat = model.predict(dx, verbose=0)\n","  WQIv=list(yhat[0])\n","  #print(WQIv[0])\n","  dict = {'WQI':WQIv}\n","  WQIout = pd.DataFrame(dict)\n","  #print(WQIout)\n","  wqi_data = WQIout[['WQI']]\n","\n","\n","\n","  # resultx = df[\"WQI\"].iloc[2]\n","  g = wqi_data[\"WQI\"].iloc[0]\n","  resultx = float(\"{:.2f}\".format(g))\n","\n","  return resultx"],"metadata":{"id":"jAT5kNHA2Z3k"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["@anvil.server.callable\n","def getgrade(wqi_result):\n","\n","  filepath= '/content/drive/MyDrive/Anvil_HydraSave/lgbmmodel.model'\n","  loaded_model = lgb.Booster(model_file=filepath)\n","\n","  wqi_value = wqi_result\n","  prediction = loaded_model.predict(wqi_value)\n","  labels = np.argmax(prediction, axis=1)\n","  val = labels[0]\n","  class_map = { 0: 'Excellent',1: 'Good', 2: 'Medium', 3: 'Poor', 4: 'Unsuitable for drinking'}\n","  grade = class_map[val]\n","  # print(\" Quality Grade =\",grade)\n","\n","  result = grade\n","  return result"],"metadata":{"id":"c9IwJOMn4oDf"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["## Server Online"],"metadata":{"id":"1OvNUV3GrNNW"}},{"cell_type":"code","source":["# anvil.server.wait_forever()"],"metadata":{"id":"amWOz41crLYv","colab":{"base_uri":"https://localhost:8080/"},"outputId":"47554e2f-d28a-48d8-8245-0fb57bddd065"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Epoch 1/400\n","1/1 [==============================] - 4s 4s/step - loss: 2481.4058\n","Epoch 2/400\n","1/1 [==============================] - 0s 16ms/step - loss: 2353.9883\n","Epoch 3/400\n","1/1 [==============================] - 0s 15ms/step - loss: 2227.2856\n","Epoch 4/400\n","1/1 [==============================] - 0s 14ms/step - loss: 2092.7102\n","Epoch 5/400\n","1/1 [==============================] - 0